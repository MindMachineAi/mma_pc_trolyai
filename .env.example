# ============================================================
# PC Trợ Lý AI — mẫu biến môi trường
# Copy file này thành apps/web/.env rồi điền giá trị THẬT.
# (Prisma CLI chỉ đọc apps/web/.env; Next.js cũng đọc .env.local nếu có.)
# KHÔNG BAO GIỜ commit file .env.
# Sinh giá trị ngẫu nhiên: pnpm gen:secrets
# ============================================================

# ---------- Database (Neon Postgres) ----------
# Neon dashboard > Connection string (chọn "Pooled" cho DATABASE_URL)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Chuỗi "Direct" (không pooler) — dùng cho prisma migrate
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Session / Auth ----------
# Bắt buộc >= 32 ký tự. Đổi giá trị này = đăng xuất mọi session.
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_BYTES"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# ---------- Cấp phát thiết bị ----------
# Dùng 1 lần khi gọi POST /api/devices để tạo token cho laptop mới.
DEVICE_REGISTRATION_SECRET="REPLACE_WITH_RANDOM_32_BYTES_HEX"

# ---------- AI (DeepSeek, chuẩn OpenAI) ----------
DEEPSEEK_API_KEY="sk-REPLACE_ME"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# ---------- Cron ----------
# Bảo vệ /api/cron/analyze (Vercel Cron / GitHub Actions gửi Bearer token này)
CRON_SECRET="REPLACE_WITH_RANDOM_32_BYTES_HEX"

# ---------- App ----------
# URL công khai của dashboard (dùng trong docs/hướng dẫn agent)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
